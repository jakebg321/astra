{
  "name": "astra",
  "description": "Two-player browser space dogfight game built with React, three.js and Node",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakebg321/astra.git"
  },
  "homepage": "https://github.com/jakebg321/astra",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node --dns-result-order=ipv4first combinedServer.js",
    "start:combined": "node combinedServer.js",
    "start:all": "node start-dev.js",
    "smoke:api": "node scripts/smoke-api-core.mjs",
    "smoke:ws": "node scripts/smoke-ws-room-flow.mjs",
    "smoke:match": "node scripts/smoke-ws-room-flow.mjs --verify-history",
    "smoke:settings": "node scripts/smoke-settings.mjs",
    "preview": "vite preview",
    "demo": "node scripts/local-demo-start.mjs",
    "demo:check": "node scripts/local-demo-check.mjs"
  },
  "dependencies": {
    "@fontsource/orbitron": "5.3.0",
    "@fontsource/rajdhani": "5.3.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.13.7",
    "bcryptjs": "^2.4.3",
    "buffer": "^6.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.3",
    "fabric": "^7.4.0",
    "framer-motion": "^10.16.4",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.18.1",
    "lucide-react": "^0.358.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.16.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.5",
    "three": "^0.159.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/three": "^0.162.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^7.3.8"
  },
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "canvas@3.2.3": false
  },
  "overrides": {
    "sucrase": {
      "glob": "^14.0.2"
    }
  }
